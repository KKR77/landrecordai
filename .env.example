# Supabase Configuration
# Get these from your Supabase project settings
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Service role key (NEVER expose in client-side code)
# Only use in server-side functions or Edge Functions
# VITE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Application Settings
VITE_APP_NAME=Land Record Digitisation Platform
VITE_APP_ENV=development

# Feature Flags
VITE_ENABLE_MOCK_DATA=true
VITE_ENABLE_ANALYTICS=false

# AI Service Configuration (Phase 2)
# URL of the AI microservice (FastAPI)
AI_SERVICE_URL=http://localhost:8000

# Notification Configuration (Phase 5)
# Twilio (SMS)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+1234567890

# WhatsApp Business API (Meta)
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id

# DILRMP Sync Configuration (Phase 5)
# ⚠️  STUB: Currently points to mock endpoint
# Replace with real DILRMP API URL for production
DILRMP_API_URL=http://localhost:8001/dilrmp-stub
DILRMP_API_KEY=your-dilrmp-api-key

# Supabase Edge Function Environment Variables
# These are set in Supabase dashboard, not in .env file
# AI_SERVICE_URL=https://your-ai-service-url.com
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# TWILIO_ACCOUNT_SID=your-twilio-account-sid
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_FROM_NUMBER=+1234567890
# WHATSAPP_API_URL=https://graph.facebook.com/v18.0
# WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
# WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
# DILRMP_API_URL=https://real-dilrmp-api.gov.in/sync
# DILRMP_API_KEY=your-dilrmp-api-key
